# Azure OpenAI Configuration
# Get these from: Azure Portal > Azure OpenAI Service > Keys and Endpoint
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT= your_azure_openai_api_endpoint_here

# ChromaDB Configuration
# Get these from your ChromaDB deployment
CHROMADB_HOST=your_chromadb_host_here
CHROMADB_PORT=8000
# Chroma Token on DEV keyvault
CHROMADB_TOKEN=your_chromadb_token_here

# Optional: Azure OpenAI Embedding Model Deployment Name
# Default is text-embedding-ada-002 if not specified
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Azure OpenAI Configuration
# Get these from: Azure Portal > Azure OpenAI Service > Keys and Endpoint
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=your_azure_openai_api_endpoint_here

# ChromaDB Configuration
# Get these from your ChromaDB deployment
CHROMADB_HOST=your_chromadb_host_here
CHROMADB_PORT=8000
# Chroma Token on DEV keyvault
CHROMADB_TOKEN=your_chromadb_token_here

# Optional: Azure OpenAI Embedding Model Deployment Name
# Default is text-embedding-ada-002 if not specified
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# =====================================
# Example values (replace with actual):
# =====================================

# Example Azure OpenAI API Key (32 characters)
# AZURE_OPENAI_API_KEY=abcd1234567890abcd1234567890abcd

# Example Azure OpenAI Endpoint
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com

# Example ChromaDB Host (your deployment URL)
# CHROMADB_HOST=your-chromadb-instance.com
# or for local development:
# CHROMADB_HOST=localhost

# Example ChromaDB Port (default is 8000)
# CHROMADB_PORT=8000

# Example ChromaDB Token (get from DEV KeyVault)
# CHROMADB_TOKEN=your-secret-token-here